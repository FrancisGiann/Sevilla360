# Keep deployment credentials and environment variants out of version control.
.env
.env.*
!.env.example

# Ignore Composer Vendor folder (Standard PHP practice)
vendor/

# Ignore locally installed realtime gateway dependencies
realtime/node_modules/

# Ignore error logs
error_log
*.log
# Local scratch files may contain test data or credentials.
scratch/
# Keep runtime storage private and out of Git deployments.
storage/
