# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=sevilla360

# Resend email delivery. The sending domain must be verified with Resend first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=reservations@misevillas.com
RESEND_REPLY_TO=

# Application Security Key (Used for HMAC Database Signatures)
# Generate a unique random value with at least 32 randomly generated characters for every deployment.
APP_KEY=
# Public origin used in password-reset links. Use HTTPS in production;
# http://localhost is allowed for local development.
APP_BASE_URL=https://your-domain.example/Sevilla360

# Comma/space-separated exact proxy IPs or CIDR ranges. Forwarded headers are
# ignored unless REMOTE_ADDR is one of these immediate trusted peers.
TRUSTED_PROXIES=
# Upload/restore safety limits (bytes/pixels/dimensions).
# Keep below PHP's typical 50M request ceiling for multipart overhead.
MEDIA_MAX_IMAGE_BYTES=50331648
MEDIA_MAX_IMAGE_PIXELS=40000000
MEDIA_MAX_IMAGE_WIDTH=10000
MEDIA_MAX_IMAGE_HEIGHT=10000
BACKUP_MAX_BYTES=52428800
# Maximum uncompressed SQL size accepted while inspecting or restoring an archive.
BACKUP_MAX_UNCOMPRESSED_BYTES=536870912
# Absolute private filesystem path outside the web/document root. No fallback is used.
BACKUP_DIR=/var/lib/sevilla360/backups
# Optional explicit executable paths when Hostinger does not put these clients on PATH.
MYSQLDUMP_BIN=
MYSQL_BIN=
# Dedicated, pre-provisioned disposable database used only for restore preflight.
# Keep all four fields empty to disable restore until staging is configured.
DB_STAGING_HOST=
DB_STAGING_USER=
DB_STAGING_PASS=
DB_STAGING_NAME=
DB_STAGING_PORT=
# Daily snapshot hour in Asia/Manila; the CLI worker checks this each time cron runs.
BACKUP_DAILY_HOUR=3
# Customer proof images are sensitive; configure a separate non-public directory.
PAYMENT_PROOF_DIR=/var/lib/sevilla360/payment-proofs

# Optional Google OpenID Connect customer sign-in. The button stays hidden
# unless all values are present, the Composer google/apiclient package is
# installed, and the redirect URI exactly matches Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-domain.example/actions/auth/google_callback.php

# Optional authenticated WebSocket/Redis notification delivery. Polling stays
# active when this is unset. Use a random key of at least 32 characters and
# exact comma-separated browser origins; run realtime/gateway.mjs only after
# provisioning Redis and installing realtime/package.json dependencies.
REALTIME_ENABLED=0
REALTIME_SIGNING_KEY=
REALTIME_WS_URL=wss://your-domain.example/realtime
REALTIME_ALLOWED_ORIGINS=https://your-domain.example
REALTIME_REDIS_URL=redis://127.0.0.1:6379
REALTIME_WS_PORT=8787
REALTIME_TOKEN_TTL=60

# Optional AI virtual receptionist. Keep disabled until a provider key/model
# are configured in the deployment environment; never commit a real key.
AI_ENABLED=0
AI_PROVIDER=openrouter
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=
AI_TIMEOUT_SECONDS=20
AI_MAX_OUTPUT_TOKENS=600
# Google Gemini reasoning effort: low, medium, or high. Ignored by other providers.
AI_GOOGLE_REASONING_EFFORT=low
AI_SITE_URL=https://your-domain.example/Sevilla360
AI_SITE_NAME=Sevilla360

# Natural hybrid receptionist v2. Leave off until the bounded conversation
# evaluation is accepted; the legacy path remains active when this is 0.
RECEPTIONIST_NATURAL_HYBRID_ENABLED=0
